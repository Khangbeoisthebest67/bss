try("Scanner", function()
    local TweenService = game:GetService("TweenService")
    local env = getgenv()
    env.TweenSpeed = 90
    env.EggRadius = 100
    env.EggWait = 3
    env.ViciousDetect, env.ViciousTween = false, false
    env.MushDetect, env.MushTween = false, false
    env.EggAuto = false

    local function root()
        local c = v5.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    local function partOf(inst)
        if inst:IsA("BasePart") then return inst end
        if inst:IsA("Model") then
            return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
        end
    end

    -- tween theo toc do (studs/giay), tu huy khi tat chuc nang
    local function tweenTo(pos, wanted)
        local hrp = root()
        if not hrp then return false end
        local t = math.clamp((hrp.Position - pos).Magnitude / env.TweenSpeed, 0.2, 15)
        local tw = TweenService:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
        tw:Play()
        local started = os.clock()
        while os.clock() - started < t + 0.3 and tw.PlaybackState == Enum.PlaybackState.Playing do
            if (wanted and not wanted()) or env.KhangAlive ~= aliveId then
                tw:Cancel()
                return false
            end
            task.wait(0.05)
        end
        return true
    end

    -- quet theo ten (khong phan biet hoa thuong); tra ve danh sach part, gan nhat truoc
    local function scan(pattern, rootNames, deep)
        local found, seen = {}, {}
        local function check(inst)
            if inst.Name:lower():find(pattern, 1, true) then
                local p = partOf(inst)
                if p and not seen[p] and p:IsDescendantOf(workspace) then
                    seen[p] = true
                    table.insert(found, p)
                end
            end
        end
        for _, n in ipairs(rootNames) do
            local r = workspace:FindFirstChild(n)
            if r then
                for _, d in ipairs(r:GetDescendants()) do check(d) end
            end
        end
        if #found == 0 and deep then
            for _, d in ipairs(workspace:GetDescendants()) do check(d) end
        end
        local hrp = root()
        if hrp then
            table.sort(found, function(a, b)
                return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
            end)
        end
        return found
    end

    local fieldNames = {
        "Sunflower", "Dandelion", "Mushroom", "Blue_Flower", "Clover", "Spider",
        "Strawberry", "Bamboo", "Pineapple", "Stump", "Pumpkin", "Cactus", "Rose",
        "PineTreeForest", "Mountain", "Coconut", "Pepper",
    }

    local Scan = UI:NewTab("Scanner", "")
    Scan:Section("Vicious Bee")
    local viciousLabel = Scan:TextBox("Vicious Bee: not scanned")
    Scan:Toggle("Detect Vicious Bee", false, function(a) env.ViciousDetect = a end)
    Scan:Toggle("Auto Tween to Vicious Bee", false, function(a)
        env.ViciousTween = a
        if a and env.AutoFarm then Notify("Scanner", "Turn off Autofarm to use tween", 3) end
    end)
    Scan:Section("Mushroom (Puffshroom)")
    local mushLabel = Scan:TextBox("Mushroom: not scanned")
    Scan:Toggle("Detect Mushroom", false, function(a) env.MushDetect = a end)
    Scan:Toggle("Auto Tween to Mushroom", false, function(a)
        env.MushTween = a
        if a and env.AutoFarm then Notify("Scanner", "Turn off Autofarm to use tween", 3) end
    end)
    Scan:Section("Eggs")
    local eggLabel = Scan:TextBox("Eggs: off")
    Scan:Toggle("Auto Collect Eggs (all fields)", false, function(a)
        env.EggAuto = a
        if a and env.AutoFarm then Notify("Scanner", "Turn off Autofarm to use tween", 3) end
        if not a then eggLabel:Set("Eggs: off") end
    end)
    Scan:Slider("Egg search radius", 100, 30, 300, false, function(v) env.EggRadius = v end)
    Scan:Slider("Wait per field (s)", 3, 1, 10, false, function(v) env.EggWait = v end)
    Scan:Section("Tween")
    Scan:Slider("Tween speed", 90, 30, 200, false, function(v) env.TweenSpeed = v end)

    -- vong lap quet Vicious Bee + Mushroom
    task.spawn(function()
        local lastVic, lastMush
        local deepAt = {vic = 0, mush = 0}
        while env.KhangAlive == aliveId do
            task.wait(1)
            local hrp = root()
            if hrp then
                if env.ViciousDetect or env.ViciousTween then
                    local deep = os.clock() - deepAt.vic > 4
                    if deep then deepAt.vic = os.clock() end
                    local list = scan("vicious", {"Monsters", "Particles"}, deep)
                    local p = list[1]
                    if p then
                        viciousLabel:Set("Vicious Bee: " .. math.floor((p.Position - hrp.Position).Magnitude) .. " studs")
                        if lastVic ~= p then
                            lastVic = p
                            Notify("Scanner", "Vicious Bee found!", 4)
                        end
                        if env.ViciousTween and not env.AutoFarm then
                            tweenTo(p.Position + Vector3.new(0, 6, 0), function() return env.ViciousTween end)
                        end
                    else
                        lastVic = nil
                        viciousLabel:Set("Vicious Bee: not found")
                    end
                end
                if env.MushDetect or env.MushTween then
                    local deep = os.clock() - deepAt.mush > 4
                    if deep then deepAt.mush = os.clock() end
                    local list = scan("puffshroom", {"Happenings"}, deep)
                    local p = list[1]
                    if p then
                        mushLabel:Set("Mushroom: " .. math.floor((p.Position - hrp.Position).Magnitude) .. " studs")
                        if lastMush ~= p then
                            lastMush = p
                            Notify("Scanner", "Puffshroom found!", 4)
                        end
                        if env.MushTween and not env.AutoFarm then
                            tweenTo(p.Position + Vector3.new(0, 5, 0), function() return env.MushTween end)
                        end
                    else
                        lastMush = nil
                        mushLabel:Set("Mushroom: not found")
                    end
                end
            end
        end
    end)

    -- vong lap nhat trung o nhieu khu vuc
    task.spawn(function()
        local total = 0
        while env.KhangAlive == aliveId do
            task.wait(0.5)
            if env.EggAuto and not env.AutoFarm and root() then
                for _, field in ipairs(fieldNames) do
                    if not env.EggAuto or env.AutoFarm or env.KhangAlive ~= aliveId then break end
                    local info = tbl and tbl[field]
                    if info then
                        eggLabel:Set("Eggs: going to " .. field .. " (" .. total .. " collected)")
                        local arrived = tweenTo(info.loc + Vector3.new(0, 5, 0), function()
                            return env.EggAuto and not env.AutoFarm
                        end)
                        if arrived then
                            local t0 = os.clock()
                            while env.EggAuto and not env.AutoFarm and os.clock() - t0 < env.EggWait do
                                local hrp = root()
                                if not hrp then break end
                                local got = false
                                for _, e in ipairs(scan("egg", {"Collectibles", "Happenings"}, false)) do
                                    if (e.Position - hrp.Position).Magnitude <= env.EggRadius then
                                        local cd = e:FindFirstChildWhichIsA("ClickDetector", true)
                                        local pp = e:FindFirstChildWhichIsA("ProximityPrompt", true)
                                        if cd and type(fireclickdetector) == "function" then fireclickdetector(cd) end
                                        if pp and type(fireproximityprompt) == "function" then fireproximityprompt(pp) end
                                        tweenTo(e.Position + Vector3.new(0, 2, 0), function()
                                            return env.EggAuto and not env.AutoFarm
                                        end)
                                        total = total + 1
                                        got = true
                                        break
                                    end
                                end
                                if not got then task.wait(0.3) end
                            end
                        end
                    end
                end
            end
        end
    end)
end)
