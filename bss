-- Giao diện kiểu Khang Hub: sidebar bên trái, nội dung bên phải,
-- Toggle / Slider / Bind / Dropdown / Button / Label.
local KhangUI = {}
do
    local TweenService = game:GetService("TweenService")
    local RealUIS = game:GetService("UserInputService")
    local conns = {}
    KhangUI.Conns = conns
    local function tracked(signal)
        return {Connect = function(_, fn)
            local c = signal:Connect(fn)
            table.insert(conns, c)
            return c
        end}
    end
    local UIS = {
        InputBegan = tracked(RealUIS.InputBegan),
        InputChanged = tracked(RealUIS.InputChanged),
        InputEnded = tracked(RealUIS.InputEnded),
    }
    local CoreGui = game:GetService("CoreGui")

    local Theme = {
        Window  = Color3.fromRGB(12, 12, 14),
        Side    = Color3.fromRGB(18, 18, 20),
        Content = Color3.fromRGB(6, 6, 7),
        Row     = Color3.fromRGB(24, 24, 26),
        RowHover= Color3.fromRGB(32, 32, 35),
        Accent  = Color3.fromRGB(104, 196, 232),
        Title   = Color3.fromRGB(86, 168, 232),
        Text    = Color3.fromRGB(222, 222, 226),
        Sub     = Color3.fromRGB(140, 140, 148),
        Off     = Color3.fromRGB(44, 44, 48),
        Close   = Color3.fromRGB(214, 62, 62),
        Font    = Enum.Font.Gotham,
        FontB   = Enum.Font.GothamBold,
    }

    local function new(class, props, parent)
        local obj = Instance.new(class)
        for k, v in pairs(props or {}) do obj[k] = v end
        if parent then obj.Parent = parent end
        return obj
    end

    local function corner(parent, r)
        return new("UICorner", {CornerRadius = UDim.new(0, r or 6)}, parent)
    end

    local function tween(obj, props, t)
        TweenService:Create(obj, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad), props):Play()
    end

    local function label(parent, text, size, color, font, align)
        return new("TextLabel", {
            BackgroundTransparency = 1,
            Text = text,
            TextSize = size or 14,
            TextColor3 = color or Theme.Text,
            Font = font or Theme.Font,
            TextXAlignment = align or Enum.TextXAlignment.Left,
        }, parent)
    end

    local function makeDraggable(handle, target)
        local dragging, dragStart, startPos
        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = target.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - dragStart
                target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                            startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
    end

    ---------------------------------------------------------------- Notify
    local notifyHolder
    function KhangUI.Notify(title, text, duration)
        task.spawn(function()
            if not notifyHolder or not notifyHolder.Parent then
                local old = CoreGui:FindFirstChild("NotifyGui")
                if old then old:Destroy() end
                local gui = new("ScreenGui", {Name = "NotifyGui", ResetOnSpawn = false}, CoreGui)
                notifyHolder = new("Frame", {
                    BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(1, 1),
                    Position = UDim2.new(1, -16, 1, -16),
                    Size = UDim2.new(0, 260, 1, -32),
                }, gui)
                new("UIListLayout", {
                    Padding = UDim.new(0, 8),
                    VerticalAlignment = Enum.VerticalAlignment.Bottom,
                    HorizontalAlignment = Enum.HorizontalAlignment.Right,
                    SortOrder = Enum.SortOrder.LayoutOrder,
                }, notifyHolder)
            end
            local card = new("Frame", {
                BackgroundColor3 = Theme.Window,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 56),
            }, notifyHolder)
            corner(card, 8)
            local bar = new("Frame", {BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1,
                Size = UDim2.new(0, 3, 1, -16), Position = UDim2.new(0, 8, 0, 8)}, card)
            corner(bar, 2)
            local t1 = label(card, tostring(title), 14, Theme.Title, Theme.FontB)
            t1.Position = UDim2.new(0, 20, 0, 8); t1.Size = UDim2.new(1, -28, 0, 18); t1.TextTransparency = 1
            local t2 = label(card, tostring(text), 13, Theme.Text)
            t2.Position = UDim2.new(0, 20, 0, 28); t2.Size = UDim2.new(1, -28, 0, 18); t2.TextTransparency = 1
            tween(card, {BackgroundTransparency = 0}, 0.3)
            tween(bar, {BackgroundTransparency = 0}, 0.3)
            tween(t1, {TextTransparency = 0}, 0.3)
            tween(t2, {TextTransparency = 0}, 0.3)
            task.wait(duration or 3)
            tween(card, {BackgroundTransparency = 1}, 0.3)
            tween(bar, {BackgroundTransparency = 1}, 0.3)
            tween(t1, {TextTransparency = 1}, 0.3)
            tween(t2, {TextTransparency = 1}, 0.3)
            task.wait(0.35)
            card:Destroy()
        end)
    end

    function KhangUI.Unload()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        table.clear(conns)
        for _, n in ipairs({"KhangHub", "NotifyGui", "DogentScreenGui"}) do
            local g = CoreGui:FindFirstChild(n)
            if g then g:Destroy() end
        end
    end

    ---------------------------------------------------------------- Window
    function KhangUI.Create(title)
        local old = CoreGui:FindFirstChild("KhangHub")
        if old then old:Destroy() end

        local gui = new("ScreenGui", {
            Name = "KhangHub",
            ResetOnSpawn = false,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        }, CoreGui)

        local main = new("Frame", {
            Name = "Main",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0, 675, 0, 475),
            BackgroundColor3 = Theme.Window,
            BorderSizePixel = 0,
            ClipsDescendants = true,
        }, gui)
        corner(main, 8)

        -- tự thu nhỏ trên màn hình nhỏ / điện thoại
        local scale = new("UIScale", {}, main)
        local function fit()
            local cam = workspace.CurrentCamera
            if not cam then return end
            local vp = cam.ViewportSize
            scale.Scale = math.clamp(math.min(vp.X / 720, vp.Y / 520), 0.5, 1)
        end
        fit()
        if workspace.CurrentCamera then
            workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
        end

        -- thanh tiêu đề
        local bar = new("Frame", {
            Name = "TitleBar", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48),
        }, main)
        local ttl = label(bar, title or "Khang Hub", 17, Theme.Title, Theme.FontB)
        ttl.Position = UDim2.new(0, 18, 0, 0)
        ttl.Size = UDim2.new(1, -80, 1, 0)

        local close = new("TextButton", {
            Name = "Close",
            Position = UDim2.new(1, -40, 0, 8),
            Size = UDim2.new(0, 32, 0, 32),
            BackgroundColor3 = Theme.Close,
            AutoButtonColor = false,
            Text = "x",
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 16,
            Font = Theme.FontB,
        }, bar)
        corner(close, 6)
        close.MouseEnter:Connect(function() tween(close, {BackgroundColor3 = Color3.fromRGB(235, 82, 82)}) end)
        close.MouseLeave:Connect(function() tween(close, {BackgroundColor3 = Theme.Close}) end)
        close.MouseButton1Click:Connect(function() gui.Enabled = false end)
        makeDraggable(bar, main)

        -- sidebar
        local side = new("Frame", {
            Name = "Sidebar", Position = UDim2.new(0, 0, 0, 48),
            Size = UDim2.new(0, 163, 1, -48),
            BackgroundColor3 = Theme.Side, BorderSizePixel = 0,
        }, main)
        new("UIPadding", {PaddingTop = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}, side)
        new("UIListLayout", {Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder}, side)

        -- vùng nội dung
        local content = new("Frame", {
            Name = "Content", Position = UDim2.new(0, 163, 0, 48),
            Size = UDim2.new(1, -163, 1, -48),
            BackgroundColor3 = Theme.Content, BorderSizePixel = 0,
        }, main)

        local Window = {Tabs = {}, Current = nil, Gui = gui}

        local function selectTab(tab)
            if Window.Current == tab then return end
            if Window.Current then
                Window.Current.Page.Visible = false
                tween(Window.Current.TabBtn, {BackgroundTransparency = 1, TextColor3 = Theme.Sub})
            end
            Window.Current = tab
            tab.Page.Visible = true
            tween(tab.TabBtn, {BackgroundTransparency = 0, TextColor3 = Color3.new(1, 1, 1)})
        end

        function Window:NewTab(name, _icon)
            local btn = new("TextButton", {
                Name = name,
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = Theme.Accent,
                BackgroundTransparency = 1,
                AutoButtonColor = false,
                Text = name,
                TextColor3 = Theme.Sub,
                TextSize = 14,
                Font = Theme.Font,
                LayoutOrder = #Window.Tabs,
            }, side)
            corner(btn, 6)

            local page = new("ScrollingFrame", {
                Name = name,
                Visible = false,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 1, 0),
                CanvasSize = UDim2.new(0, 0, 0, 0),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ScrollBarThickness = 3,
                ScrollBarImageColor3 = Theme.Off,
            }, content)
            new("UIPadding", {
                PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12),
                PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 14),
            }, page)
            new("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder}, page)

            local Tab = {TabBtn = btn, Page = page, _order = 0}
            table.insert(Window.Tabs, Tab)

            btn.MouseButton1Click:Connect(function() selectTab(Tab) end)
            btn.MouseEnter:Connect(function()
                if Window.Current ~= Tab then btn.TextColor3 = Theme.Text end
            end)
            btn.MouseLeave:Connect(function()
                if Window.Current ~= Tab then btn.TextColor3 = Theme.Sub end
            end)

            local function nextOrder()
                Tab._order = Tab._order + 1
                return Tab._order
            end
            local function row(height)
                local r = new("Frame", {
                    Size = UDim2.new(1, 0, 0, height or 42),
                    BackgroundColor3 = Theme.Row,
                    BorderSizePixel = 0,
                    LayoutOrder = nextOrder(),
                }, page)
                corner(r, 6)
                return r
            end
            local function rowTitle(r, text)
                local l = label(r, text, 14, Theme.Text)
                l.Position = UDim2.new(0, 16, 0, 0)
                l.Size = UDim2.new(1, -100, 0, 42)
                return l
            end

            function Tab:Section(text)
                local l = label(page, string.upper(text), 12, Theme.Title, Theme.FontB)
                l.Size = UDim2.new(1, 0, 0, 22)
                l.LayoutOrder = nextOrder()
                return l
            end

            function Tab:TextBox(text)
                local r = row(36)
                local l = rowTitle(r, text)
                l.Size = UDim2.new(1, -32, 1, 0)
                l.TextColor3 = Theme.Sub
                return {Set = function(_, t) l.Text = t end}
            end
            Tab.Label = Tab.TextBox

            function Tab:Button(text, callback)
                local r = row(42)
                local b = new("TextButton", {
                    BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                    Text = "", AutoButtonColor = false,
                }, r)
                local l = rowTitle(r, text)
                local arrow = label(r, ">", 14, Theme.Sub, Theme.FontB, Enum.TextXAlignment.Right)
                arrow.Position = UDim2.new(1, -34, 0, 0); arrow.Size = UDim2.new(0, 20, 1, 0)
                b.MouseEnter:Connect(function() tween(r, {BackgroundColor3 = Theme.RowHover}) end)
                b.MouseLeave:Connect(function() tween(r, {BackgroundColor3 = Theme.Row}) end)
                b.MouseButton1Click:Connect(function()
                    tween(r, {BackgroundColor3 = Theme.Accent}, 0.08)
                    task.delay(0.12, function() tween(r, {BackgroundColor3 = Theme.RowHover}) end)
                    if callback then task.spawn(callback) end
                end)
            end

            function Tab:Toggle(text, default, callback)
                local r = row(42)
                rowTitle(r, text)
                local sw = new("Frame", {
                    Position = UDim2.new(1, -58, 0.5, -11), Size = UDim2.new(0, 42, 0, 22),
                    BackgroundColor3 = Theme.Off, BorderSizePixel = 0,
                }, r)
                corner(sw, 11)
                local knob = new("Frame", {
                    Position = UDim2.new(0, 3, 0.5, -8), Size = UDim2.new(0, 16, 0, 16),
                    BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
                }, sw)
                corner(knob, 8)
                local state = false
                local function render(v)
                    state = v
                    tween(sw, {BackgroundColor3 = v and Theme.Accent or Theme.Off})
                    tween(knob, {Position = v and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)})
                end
                local b = new("TextButton", {
                    BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Text = "",
                }, r)
                b.MouseButton1Click:Connect(function()
                    render(not state)
                    if callback then task.spawn(callback, state) end
                end)
                if default then render(true) end
                return {Set = function(_, v) render(v and true or false) if callback then task.spawn(callback, state) end end}
            end

            function Tab:Slider(text, default, min, max, _unused, callback)
                min = min or 0; max = max or 100
                local value = math.clamp(default or min, min, max)
                local r = row(60)
                local l = label(r, text, 14, Theme.Text)
                l.Position = UDim2.new(0, 16, 0, 8); l.Size = UDim2.new(1, -100, 0, 20)
                local v = label(r, tostring(value), 12, Theme.Sub, Theme.Font, Enum.TextXAlignment.Right)
                v.Position = UDim2.new(1, -66, 0, 8); v.Size = UDim2.new(0, 50, 0, 20)

                local hit = new("TextButton", {
                    Position = UDim2.new(0, 16, 0, 34), Size = UDim2.new(1, -32, 0, 20),
                    BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
                }, r)
                local track = new("Frame", {
                    Position = UDim2.new(0, 0, 0.5, -2), Size = UDim2.new(1, 0, 0, 4),
                    BackgroundColor3 = Theme.Off, BorderSizePixel = 0,
                }, hit)
                corner(track, 2)
                local fill = new("Frame", {
                    Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
                }, track)
                corner(fill, 2)
                local knob = new("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.new(0, 12, 0, 12), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
                }, fill)
                corner(knob, 6)

                local function setValue(val, fire)
                    val = math.clamp(math.floor(val + 0.5), min, max)
                    value = val
                    v.Text = tostring(val)
                    fill.Size = UDim2.new((val - min) / math.max(max - min, 1), 0, 1, 0)
                    if fire and callback then task.spawn(callback, val) end
                end
                setValue(value, false)

                local dragging = false
                local function fromInput(input)
                    local a = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
                    setValue(min + math.clamp(a, 0, 1) * (max - min), true)
                end
                hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        fromInput(input)
                    end
                end)
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
                UIS.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        fromInput(input)
                    end
                end)
                return {Set = function(_, val) setValue(val, true) end}
            end

            function Tab:KeyBind(text, default, callback)
                local key = default
                local listening = false
                local r = row(42)
                rowTitle(r, text)
                local b = new("TextButton", {
                    Position = UDim2.new(1, -124, 0.5, -14), Size = UDim2.new(0, 108, 0, 28),
                    BackgroundColor3 = Theme.Off, AutoButtonColor = false,
                    Text = key and key.Name or "None",
                    TextColor3 = Theme.Text, TextSize = 13, Font = Theme.Font,
                }, r)
                corner(b, 5)
                b.MouseButton1Click:Connect(function()
                    listening = true
                    b.Text = "..."
                end)
                UIS.InputBegan:Connect(function(input, processed)
                    if listening then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            listening = false
                            if input.KeyCode == Enum.KeyCode.Escape then
                                key = nil
                                b.Text = "None"
                            else
                                key = input.KeyCode
                                b.Text = key.Name
                            end
                        end
                        return
                    end
                    if key and not processed and input.KeyCode == key then
                        if callback then task.spawn(callback) end
                    end
                end)
            end

            function Tab:DropDown(text, list, _reset, callback, defaultText)
                local container = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundColor3 = Theme.Row, BorderSizePixel = 0,
                    ClipsDescendants = true, LayoutOrder = nextOrder(),
                }, page)
                corner(container, 6)
                local head = new("TextButton", {
                    BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), Text = "",
                }, container)
                local t = label(head, text, 14, Theme.Text)
                t.Position = UDim2.new(0, 16, 0, 0); t.Size = UDim2.new(0.5, -16, 1, 0)
                local sel = label(head, defaultText or "Select  v", 13, Theme.Sub, Theme.Font, Enum.TextXAlignment.Right)
                sel.Position = UDim2.new(0.4, 0, 0, 0); sel.Size = UDim2.new(0.6, -16, 1, 0)

                local listFrame = new("ScrollingFrame", {
                    Position = UDim2.new(0, 8, 0, 46), Size = UDim2.new(1, -16, 1, -52),
                    BackgroundTransparency = 1, BorderSizePixel = 0,
                    ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Off,
                    CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                }, container)
                new("UIListLayout", {Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder}, listFrame)

                local open = false
                local count = 0
                local function resize()
                    local h = 42
                    if open then h = 42 + math.min(count * 31 + 10, 190) end
                    tween(container, {Size = UDim2.new(1, 0, 0, h)}, 0.18)
                end
                head.MouseButton1Click:Connect(function() open = not open resize() end)

                local obj = {}
                function obj:SetList(items)
                    for _, c in ipairs(listFrame:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    count = 0
                    for i, item in ipairs(items) do
                        count = count + 1
                        local o = new("TextButton", {
                            Size = UDim2.new(1, -4, 0, 28),
                            BackgroundColor3 = Theme.Off, BackgroundTransparency = 0.4,
                            AutoButtonColor = false, Text = tostring(item),
                            TextColor3 = Theme.Text, TextSize = 13, Font = Theme.Font,
                            LayoutOrder = i,
                        }, listFrame)
                        corner(o, 5)
                        o.MouseEnter:Connect(function() tween(o, {BackgroundTransparency = 0}) end)
                        o.MouseLeave:Connect(function() tween(o, {BackgroundTransparency = 0.4}) end)
                        o.MouseButton1Click:Connect(function()
                            sel.Text = tostring(item)
                            open = false
                            resize()
                            if callback then task.spawn(callback, item) end
                        end)
                    end
                    resize()
                end
                obj:SetList(list or {})
                return obj
            end

            if not Window.Current then selectTab(Tab) end
            return Tab
        end

        return Window
    end
end

